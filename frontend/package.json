{
  "name": "fooddiary-frontend",
  "version": "1.0.0",
  "description": "FoodDiary SPA — React + TypeScript + Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "react-i18next": "^15.0.1",
    "i18next": "^23.14.0",
    "axios": "^1.7.5",
    "framer-motion": "^11.3.28",
    "react-icons": "^5.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5",
    "@vitest/coverage-v8": "^2.0.5",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.10",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
